{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Fab City Network — city.json (schema 1.1)",
  "type": "object",
  "required": [
    "schema_version",
    "city"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "enum": [
        "1.0",
        "1.1"
      ]
    },
    "is_sample": {
      "type": "boolean",
      "description": "true shows the sample ribbon; set false only when every placeholder is replaced"
    },
    "city": {
      "type": "object",
      "required": [
        "name"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "country": {
          "type": "string"
        },
        "subdomain": {
          "type": "string",
          "pattern": "^[a-z0-9-]*$"
        },
        "type": {
          "type": "string",
          "enum": [
            "city",
            "region",
            "country",
            "island"
          ]
        },
        "joined_year": {
          "type": "integer",
          "minimum": 2011
        },
        "differential": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "hero_image": {
          "type": "string"
        },
        "local_site_url": {
          "type": "string",
          "description": "Optional. Your existing full website; adds a 'Visit our full website' button to the hero."
        },
        "language": {
          "type": "string",
          "pattern": "^[a-zA-Z]{2,3}(-[a-zA-Z0-9]{2,8})*$",
          "description": "Optional. BCP-47 code of the language you wrote the page in (\"hr\", \"pt-BR\"). Sets the page's lang attribute so screen readers and browser translation treat it correctly. Defaults to \"en\"."
        }
      }
    },
    "contact": {
      "type": "object",
      "properties": {
        "email": {
          "type": "string"
        },
        "social": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "label": {
                "type": "string"
              },
              "url": {
                "type": "string"
              }
            }
          }
        }
      }
    },
    "analytics": {
      "type": "object",
      "description": "Optional. Both fields required for analytics to load; the site must also be live (is_sample:false).",
      "properties": {
        "plausible_domain": {
          "type": "string"
        },
        "privacy_url": {
          "type": "string"
        }
      }
    },
    "data_snapshot": {
      "type": "array",
      "description": "Only the first 6 entries are rendered. Extra entries are a warning, not an error.",
      "items": {
        "type": "object",
        "required": [
          "label",
          "value"
        ],
        "properties": {
          "label": {
            "type": "string"
          },
          "value": {
            "type": "string"
          }
        }
      }
    },
    "ecosystem": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "name"
        ],
        "properties": {
          "name": {
            "type": "string"
          },
          "type": {
            "type": "string"
          },
          "summary": {
            "type": "string"
          },
          "url": {
            "type": "string"
          },
          "lat": {
            "type": "number"
          },
          "lng": {
            "type": "number"
          },
          "logo": {
            "type": "string"
          }
        }
      }
    },
    "projects": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "title"
        ],
        "properties": {
          "title": {
            "type": "string"
          },
          "status": {
            "type": "string"
          },
          "summary": {
            "type": "string"
          },
          "partners": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "image": {
            "type": "string"
          },
          "url": {
            "type": "string"
          }
        }
      }
    },
    "news": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "date",
          "title"
        ],
        "properties": {
          "date": {
            "type": "string",
            "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
          },
          "title": {
            "type": "string"
          },
          "summary": {
            "type": "string"
          },
          "url": {
            "type": "string"
          }
        }
      }
    },
    "events": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "date",
          "title"
        ],
        "properties": {
          "date": {
            "type": "string",
            "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
          },
          "title": {
            "type": "string"
          },
          "venue": {
            "type": "string"
          },
          "url": {
            "type": "string"
          }
        }
      }
    },
    "ui_labels": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    }
  }
}
